# R IDE artifacts
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Generated website content -- except the built site itself (docs/,
# committed so GitHub Pages can serve it directly from main) and the
# dated data-dict snapshots under articles/
*.html
!docs/**/*.html
!articles/*.html

# Parquet files — test/seed data (tracked via Git LFS)
# Tracked with git lfs track "*.parquet"

# Keep inst/ directory structure in git
!/inst/.gitkeep

# Build artifacts (regenerated on R CMD check)
/opus.Rcheck/
/opus_*.tar.gz

# Quarto build cache and per-page side-folders (regenerated on render)
/.quarto/
**/*_files/

# Generated HTML assets from Quarto processing
/data-raw/DATRAS-data-dict_files/

# Development seed data (upstream sources)
data-raw/seed/

# Retired working notes (analysis, prototypes, iterations)
*_retired.md
*_retired.R
*_retired.csv
*_retired.html

# Runtime artifacts
.datras/
logs/
/scripts/

# Incomplete work and scratch files
/imbus-interim-note-mockup.qmd
/tmp
contract.md

**/*.quarto_ipynb
